{
  "name": "waka-box",
  "version": "3.0.0",
  "private": true,
  "description": "Update a GitHub Gist with weekly WakaTime statistics",
  "author": "bossm0n5t3r <bossm0n5t3r@gmail.com>",
  "contributors": [
    "Matan Kushner <hello@matchai.me>"
  ],
  "license": "ISC",
  "scripts": {
    "start": "node index.ts",
    "start:local": "node --env-file=.env index.ts",
    "typecheck": "tsc",
    "format": "prettier --write index.ts package.json tsconfig.json README.md .github/workflows/schedule.yaml",
    "format:check": "prettier --check index.ts package.json tsconfig.json README.md .github/workflows/schedule.yaml"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
