{
  "name": "waka-box",
  "version": "3.0.0",
  "description": "📊 Update a gist to contain your weekly WakaTime stats",
  "author": "Matan Kushner <hello@matchai.me>",
  "license": "ISC",
  "scripts": {
    "start": "node index.ts",
    "start:local": "node --env-file=.env index.ts",
    "typecheck": "tsc",
    "format": "prettier --write index.ts package.json tsconfig.json .github/workflows/schedule.yml",
    "format:check": "prettier --check index.ts package.json tsconfig.json .github/workflows/schedule.yml"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
